# ── Public (exposed to the browser) ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Optional. Without it the app falls back to an OpenStreetMap embed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── BetterAuth (server only) ──────────────────────────────────────
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of THIS app. No trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Use the SAME database as the Express API
MONGODB_URI=mongodb://127.0.0.1:27017/vroomly
MONGODB_DB=vroomly
# If your network refuses Atlas SRV lookups ("querySrv ECONNREFUSED") the app resolves the address over HTTPS automatically.
# Optional: also point Node at public DNS:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Google sign-in. Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP for password-reset emails. Without it the reset link is printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vroomly <no-reply@vroomly.app>"
